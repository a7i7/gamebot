# Copy this to .env.prod and fill in real values.
# .env.prod is gitignored — never commit it.

POSTGRES_USER=gamebot
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=gamebot

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_SECRET_KEY

# Comma-separated list of allowed CORS origins (your Vercel frontend URL)
ALLOWED_ORIGINS=https://YOUR_APP.vercel.app
